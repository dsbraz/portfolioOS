# Runner for the end-to-end suite: browsers already installed, matched to the
# @playwright/test version in package.json. Bumping one means bumping the other
# — Playwright refuses to drive browsers it was not built against.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app

# Only the manifests, so the dependency layer survives a change to a spec.
COPY package.json package-lock.json ./
RUN npm ci

# Browser MCP for the agent evaluations (Server/evals), pinned to the version
# whose Playwright matches this image's bundled browsers. A floating `@latest`
# resolves to a newer Playwright and downloads a second browser at run time —
# slow, and it makes an evaluation depend on the network.
RUN npm install --no-save @playwright/mcp@0.0.78 \
    # The MCP nests its own Playwright (an alpha), which pins a browser
    # revision the image does not carry — 1232 vs the image's 1234. The install
    # must run through the MCP's OWN CLI, or `npx` resolves the root Playwright
    # and fetches the wrong revision, and the first agent run then downloads
    # ~150 MB mid-evaluation. Fetching HERE, at build time, keeps an evaluation
    # offline and repeatable.
    # SKIP_BROWSER_GC: the nested CLI garbage-collects every browser absent
    # from ITS registry — which is all of them, including the chromium-1234 the
    # test suite runs on. Without the flag this line deletes the suite's
    # browser while installing the MCP's.
    && PLAYWRIGHT_SKIP_BROWSER_GC=1 \
       node node_modules/@playwright/mcp/cli.js install-browser chrome-for-testing

COPY playwright.config.ts ./
COPY e2e ./e2e

CMD ["npx", "playwright", "test"]
