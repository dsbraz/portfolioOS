# =============================================================================
# Production deployment config — copy to .env.production and fill in values
# =============================================================================

# --- Required ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=southamerica-east1
CLOUD_SQL_CONNECTION=your-project:southamerica-east1:portfolioos-db
DATABASE_URL=postgresql+asyncpg://portfolio:YOUR_PASSWORD@/portfolio_db?host=/cloudsql/your-project:southamerica-east1:portfolioos-db
SECRET_KEY=<generate with: openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional (defaults shown) ---
# BACKEND_SERVICE_NAME=portfolioos-server
# FRONTEND_SERVICE_NAME=portfolioos-client
# BACKEND_MEMORY=512Mi
# BACKEND_CPU=1
# FRONTEND_MEMORY=256Mi
# FRONTEND_CPU=1

# --- Monthly reporting e-mail (optional; see DEPLOY.md §8) ---
# EMAIL_BACKEND=smtp turns it on: the deploy creates the Cloud Run Jobs and the
# Cloud Scheduler triggers. Absent, the deploy pauses any existing schedule.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=portfolio@empresa.com
# SMTP_PASSWORD=<app password>
# SMTP_SENDER="portfolioOS <portfolio@empresa.com>"
# SMTP_STARTTLS=true
# EMAIL_SIGNATURE="Equipe de Portfólio"
# APP_BASE_URL=          # defaults to the frontend URL the deploy resolves
# SCHEDULER_REGION=      # defaults to GCP_REGION
# SCHEDULER_SERVICE_ACCOUNT=  # identity that triggers the jobs; defaults to
#                             # the Compute default service account
# MONTHLY_REPORT_JOB_NAME=portfolioos-monthly-report  # prefix: -initial, -reminder
